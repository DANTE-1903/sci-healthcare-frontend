    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "storybook": "^10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
