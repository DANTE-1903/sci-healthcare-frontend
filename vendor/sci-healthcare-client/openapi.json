{
  "openapi": "3.1.0",
  "info": {
    "title": "SCI Healthcare API",
    "description": "Read-only API for the SCI Healthcare care-voucher protocol on Stellar. All monetary amounts are decimal strings representing i128 values in base units (stroops). A 7-decimal Stellar asset like USDC uses 10^7 base units per whole token, so \"30000000\" = 3.0000000 USDC. Amounts are strings, not numbers, because they can exceed Number.MAX_SAFE_INTEGER.",
    "version": "0.2.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Liveness check",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "summary": "Version and deployment info",
        "tags": [
          "health"
        ],
        "description": "Reports the build version and commit, the configured Stellar network, the RPC endpoints in use (redacted), the indexed contract ids, the configured indexer start ledger, and when this process started.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "summary": "Readiness check",
        "tags": [
          "health"
        ],
        "description": "Reports indexer lag, RPC retention gaps, and database connectivity.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
